; equilibrate.mdp - used as input into grompp to generate em.tpr
; ------------------- MELT RUN (NVT) -------------------
integrator  = md            ; Algorithm (leap-frog)
dt = 0.002                  ; Time step [ps]
nsteps = 500000             ; Total number of steps - equivalent to 0.5 ns
nstxout = 500               ; Write coordinates every 500 fs
nstenergy = 500             ; Write energies to edr file every 500 fs
nstlog = 500                ; Write energies to log file every 500 fs

; Constraints
constraints = h-bonds       ; Applies to water and H-atoms in Emim ion
constraint-algorithm = LINCS ; Algorithm for constraint generation

; Thermostat & Barostat for NVT Ensemble
tcoupl  = v_rescale         ; modified Berendsen thermostat
tc-grps = system            ; one coupling group - all atoms
tau_t   = 0.1               ; time constant [ps]
ref_t = 350 ; reference temperature, one for each group [K]
pcoupl  = no                ; no pressure coupling - constatnt volume

; Non-bonded LJ interactions settings
rvdw            = 1.20      ; Short-range Van der Waals cut-off
vdwtype         = Switch    ; Treatment of long range Van der Waals interactions
rvdw-switch     = 1.18      ; Long range Van der Waals cut-off for switch function

; Electrostatics settings
coulombtype     = PME       ; Treatment of long range electrostatic interactions
fourierspacing  = 0.12      ; Grid spacing for FFT, 0.12 nm in k-space for 1.4 nm cut-off
rcoulomb        = 1.20      ; Short-range electrostatic cut-off
